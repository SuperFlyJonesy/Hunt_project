---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Join Us - Bristol Hearing Loss Initiative"
  description="Join our Bristol Hearing Loss Initiative to access local peer discussions, accessible venue updates, assistive tech guides, and support group meetups."
  bodyClass="premium-white-theme"
>
  <style is:global>
    .container { max-width: 960px; margin: 0 auto; padding: 50px 20px 100px 20px; }
            .onboard-steps-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin: 25px 0 35px 0; }
            .onboard-step-card { background: #ffffff; border-radius: 16px; padding: 24px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; border-top: 5px solid #005EB8; text-align: center; transition: transform 0.2s ease, box-shadow 0.2s ease; }
            .onboard-step-card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,0.06); }
            .step-num { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; background: #005EB8; color: #ffffff; border-radius: 50%; font-weight: 800; font-size: 1.15rem; margin-bottom: 12px; }
            .onboard-step-card h3 { font-size: 1.15rem; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; }
            .onboard-step-card p { font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5; }
            
            .cta-box { background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%); border: 1.5px solid #bfdbfe; border-radius: 18px; padding: 32px 24px; text-align: center; margin: 30px 0; }
            .btn-portal-primary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: #005EB8; color: #ffffff; padding: 14px 32px; font-size: 1.08rem; font-weight: 800; border-radius: 30px; text-decoration: none; box-shadow: 0 4px 15px rgba(0, 94, 184, 0.35); transition: all 0.2s ease; }
            .btn-portal-primary:hover { background: #004b93; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0, 94, 184, 0.45); }
            
            .help-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px; text-align: center; margin-top: 30px; }
            .help-box a { color: #005EB8; font-weight: 700; text-decoration: none; }
            .help-box a:hover { text-decoration: underline; }
    
            /* Centered Header Logo & Admin Reset */
            .about-logo-wrapper {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                margin: 25px auto 10px auto;
                position: relative;
                z-index: 100;
            }
            #hli-logo.about-logo-top {
                height: 52px;
                width: auto;
                cursor: pointer;
                filter: contrast(1.1);
                transition: transform 0.2s ease;
            }
            #hli-logo.about-logo-top:hover {
                transform: scale(1.05);
            }
            
            
    
            @media (max-width: 768px) {
                #hli-logo.about-logo-top {
                    height: 36px;
                    top: 12px;
                    left: 12px;
                }
                
            }
  </style>

  
      
      <div class="about-logo-wrapper">
          <img src="/Contents/Branding Images/HLI logo Black.png" alt="Hearing Loss Initiative Logo" id="hli-logo" class="about-logo-top" title="Bristol Hearing Loss Initiative">
          
      </div>
  
      <!-- Top-Right About Us Button -->
      <a href="/path-about" id="btn-support" style="position: fixed; top: 15px; right: 15px; z-index: 9999999; background: #005EB8; color: white; padding: 10px 20px; text-decoration: none; font-weight: bold; border-radius: 8px; font-size: 0.9rem; transition: background 0.2s ease;">About Us</a>
  
      <main id="main-content" class="container">
          <div class="header-section" style="text-align: center; margin-bottom: 35px; margin-top: 15px;">
              <h1 style="font-size: 2.3rem; margin-bottom: 12px; color: #1b5e20; text-align: center; display: flex; align-items: center; justify-content: center; gap: 12px;">
                  <span class="material-symbols-outlined" style="font-size: 2.8rem;">volunteer_activism</span>
                  Join Our Initiative
              </h1>
              <p style="font-size: 1.12rem; color: #475569; text-align: center; max-width: 740px; margin: 0 auto; line-height: 1.6;">
                  Access local peer conversations, shared advice, accessible Bristol venue updates, and assistive technology guides.
              </p>
          </div>
  
          <div class="onboard-steps-container">
              <div class="onboard-step-card" style="border-top-color: #005EB8;">
                  <div class="step-num" style="background: #005EB8;">1</div>
                  <h3>Sign In with Google</h3>
                  <p>One-click verification gives you instant entry into the initiate portal without remembering complex passwords.</p>
              </div>
              <div class="onboard-step-card" style="border-top-color: #059669;">
                  <div class="step-num" style="background: #059669;">2</div>
                  <h3>Select Your Topic</h3>
                  <p>Choose from dedicated discussion areas including general chat, audiology experiences, and local venue feedback.</p>
              </div>
              <div class="onboard-step-card" style="border-top-color: #7B1FA2;">
                  <div class="step-num" style="background: #7B1FA2;">3</div>
                  <h3>Share &amp; Connect</h3>
                  <p>Post questions, share tips on lip-reading or assistive tech, and stay informed on Bristol peer gatherings.</p>
              </div>
          </div>
  
          <div class="cta-box">
              <h2 style="font-size: 1.5rem; color: #0f172a; margin: 0 0 10px 0;">Ready to get started?</h2>
              <p style="font-size: 1rem; color: #475569; max-width: 580px; margin: 0 auto 20px auto; line-height: 1.5;">
                  Log into our free Initiate Portal to browse discussion channels, view curated Bristol resources, or join live initiative chat.
              </p>
              <a href="/portal" class="btn-portal-primary">
                  <span class="material-symbols-outlined">login</span>
                  Enter Initiate Portal &rarr;
              </a>
          </div>
  
          <div class="help-box">
              <p style="margin: 0; font-size: 0.95rem; color: #475569;">
                  Looking for our previous discussion server guidance? <a href="/path-discord-help">View the archived Discord setup guide &rarr;</a>
              </p>
          </div>
  
          <!-- Navigation Footer -->
          <nav class="back-to-journey-container" aria-label="Back Navigation" style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 40px;">
              <a href="/path-support" class="back-to-journey-btn" style="display: inline-flex; align-items: center; gap: 8px; background: #005EB8; color: white; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 700;">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Back to Support Hub
              </a>
              <a href="/path-yes" class="back-to-journey-btn" style="background: #1e293b; color: #ffffff; display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 700;">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Back to Journey Hub
              </a>
          </nav>
  
          <footer class="hli-minimal-footer">
              <span>&copy; 2026 Bristol Hearing Loss Initiative &bull; Unincorporated Non-Profit</span>
          </footer>
      </main>
  
      
</BaseLayout>
