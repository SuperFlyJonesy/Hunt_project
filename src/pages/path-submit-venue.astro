---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Redirecting to Member Portal..."
  description="Bristol venue accessibility submissions are reserved for verified members in our Member Portal."
  bodyClass="premium-white-theme"
>
  <main id="main-content" style="max-width: 650px; margin: 80px auto; padding: 40px 30px; background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.06);">
    <div style="color: #005EB8; margin-bottom: 16px;">
      <span class="material-symbols-outlined" style="font-size: 4rem;">badge</span>
    </div>
    <h1 style="font-size: 1.8rem; color: #0f172a; margin-bottom: 12px;">Member Portal Feature</h1>
    <p style="color: #475569; font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;">
      Venue accessibility submissions are part of our upcoming Member Portal toolset. Access is currently under consideration.
    </p>
    <a href="/portal" style="display: inline-flex; align-items: center; gap: 8px; background: #005EB8; color: #ffffff; padding: 14px 28px; border-radius: 12px; font-weight: 700; text-decoration: none; font-size: 1.05rem; box-shadow: 0 4px 15px rgba(0,94,184,0.3);">
      <span>Go to Member Portal</span>
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <p style="color: #94a3b8; font-size: 0.85rem; margin-top: 20px;">Redirecting automatically...</p>
    <footer class="hli-minimal-footer">
      <span>&copy; 2026 Bristol Hearing Loss Initiative &bull; Unincorporated Non-Profit</span>
    </footer>
  </main>
  <script is:inline>
    window.location.href='/portal';
  </script>
</BaseLayout>
