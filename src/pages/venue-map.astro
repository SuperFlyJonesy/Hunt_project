---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bristol Venue Accessibility Map - Hearing Loss Initiative"
  description="Explore an interactive map of accessible venues across Bristol featuring Induction Loops, Auracast, and acoustic ratings."
  bodyClass="premium-white-theme"
>
  <link rel="stylesheet" href="/styles/venue-map.css?v=47" slot="head" />

  <a href="#map" class="skip-link" style="position: absolute; top: -100px; left: 15px; background: #ff0f5b; color: #ffffff; padding: 10px 20px; border-radius: 8px; font-weight: 800; z-index: 99999999; text-decoration: none; transition: top 0.2s ease;">Skip to Map</a>
  
  <header class="map-header">
    <div class="header-left">
      <h1><span class="material-symbols-outlined" style="vertical-align: middle; font-size: 1.25rem; margin-right: 4px;">map</span> Greater Bristol Map</h1>
      <a href="/path-accessible-venues" class="compact-btn">← Venue Directory</a>
      <a href="/path-submit-venue" class="compact-btn">Add a Venue</a>
      
      <!-- Postcode Select -->
      <select id="filter-postcode" class="postcode-select" aria-label="Filter by Bristol Postcode District">
        <option value="ALL">📍 Highlight All Postcodes</option>
        <option value="NONE">🚫 No Postcodes (Hide)</option>
        <option value="BS1">BS1 - City Centre</option>
        <option value="BS2">BS2 - St Pauls &amp; Old Market</option>
        <option value="BS3">BS3 - Southville &amp; Bedminster</option>
        <option value="BS4">BS4 - Knowle &amp; Brislington</option>
        <option value="BS5">BS5 - Easton &amp; St George</option>
        <option value="BS6">BS6 - Redland &amp; Cotham</option>
        <option value="BS7">BS7 - Bishopston &amp; Horfield</option>
        <option value="BS8">BS8 - Clifton &amp; Hotwells</option>
        <option value="BS9">BS9 - Westbury-on-Trym</option>
        <option value="BS10">BS10 - Southmead &amp; Henbury</option>
        <option value="BS11">BS11 - Shirehampton &amp; Avonmouth</option>
        <option value="BS13">BS13 - Hartcliffe &amp; Withywood</option>
        <option value="BS14">BS14 - Stockwood &amp; Hengrove</option>
        <option value="BS15">BS15 - Hanham &amp; Kingswood</option>
        <option value="BS16">BS16 - Fishponds &amp; Vassall</option>
        <option value="BS20">BS20 - Portishead &amp; Pill</option>
        <option value="BS30">BS30 - Bitton &amp; Longwell Green</option>
        <option value="BS31">BS31 - Keynsham &amp; Saltford</option>
        <option value="BS32">BS32 - Bradley Stoke</option>
        <option value="BS34">BS34 - Filton &amp; Patchway</option>
        <option value="BS35">BS35 - Thornbury &amp; Severnside</option>
        <option value="BS41">BS41 - Long Ashton</option>
        <option value="BS48">BS48 - Airport &amp; Nailsea</option>
      </select>
    </div>

    <!-- Feature Checkboxes -->
    <div class="filters">
      <label>
        <input type="checkbox" id="filter-induction" checked />
        <span class="dot induction"></span>
        Loop
      </label>

      <label>
        <input type="checkbox" id="filter-auracast" checked />
        <span class="dot auracast"></span>
        Auracast
      </label>

      <label>
        <input type="checkbox" id="filter-quiet" checked />
        <span class="dot quiet"></span>
        Quiet Zone
      </label>
    </div>
  </header>

  <!-- Interactive Floating Venue List Sidebar Panel -->
  <button id="toggle-sidebar-btn" class="venue-sidebar-toggle" type="button">
    <span class="material-symbols-outlined">list</span> 📋 Submitted Venues List
  </button>

  <aside id="venue-sidebar" class="venue-sidebar collapsed">
    <div class="sidebar-header">
      <h2>📋 Submitted Venues (Unverified)</h2>
      <button id="close-sidebar-btn" type="button" style="background: none; border: none; color: #94a3b8; font-size: 1.4rem; cursor: pointer;">&times;</button>
    </div>
    <div class="sidebar-search">
      <input type="search" id="sidebar-search-input" name="hli_venue_map_search" placeholder="🔍 Search venue, postcode, or feature..." autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" data-lpignore="true" data-1p-ignore="true" data-form-type="other" />
    </div>
    <div id="sidebar-venue-list" class="sidebar-list"></div>
  </aside>

  <main id="map" style="position: relative; flex: 1; width: 100%; min-height: 0;">
    <div id="map-loader" class="map-loader">
      <div class="map-loader-spinner"></div>
      <div class="map-loader-text">Loading Greater Bristol Map...</div>
    </div>
  </main>

  <!-- Map logic loaded before API callback -->
  <script is:inline src="/js/venue-map.js?v=46"></script>

  <!-- Google Maps JS API loader -->
  <script is:inline
    async
    defer
    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBR126ydv-9UusD-VAHZI9QVwfmugu-rGQ&callback=initMap">
  </script>
</BaseLayout>
