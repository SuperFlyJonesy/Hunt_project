---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bristol Local Directory & Resources - Hearing Loss Initiative"
  description="Bristol Deaf and hard-of-hearing local service directory, contact details and venue checklists."
  bodyClass="premium-white-theme"
>
  <style is:global>
    .container { max-width: 960px; margin: 0 auto; padding: 50px 20px 100px 20px; }
            .directory-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 20px; margin-top: 15px; }
            @media (max-width: 768px) { .directory-grid { grid-template-columns: 1fr; } }
            .directory-card { background: #ffffff; border-radius: 18px; padding: 22px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; border-left: 6px solid #005EB8; display: flex; flex-direction: column; justify-content: space-between; }
            .directory-card.pink-accent { border-left-color: #ff0f5b; }
            .directory-card.green-accent { border-left-color: #1b5e20; }
            .directory-card.purple-accent { border-left-color: #7B1FA2; }
            .directory-card h3 { font-size: 1.25rem; font-weight: 800; color: #1e293b; margin: 0 0 8px 0; }
            .directory-card p { font-size: 0.95rem; color: #475569; line-height: 1.55; margin-bottom: 14px; }
            .contact-info-list { list-style: none; padding: 0; margin: 0 0 16px 0; }
            .contact-info-list li { font-size: 0.9rem; color: #334155; margin-bottom: 8px; display: flex; align-items: flex-start; gap: 8px; line-height: 1.45; }
            .contact-info-list .material-symbols-outlined { font-size: 1.15rem; color: #005EB8; flex-shrink: 0; margin-top: 2px; }
            .contact-info-list a { color: #005EB8; text-decoration: underline; font-weight: 600; }
            .site-link-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px 20px; border-radius: 20px; font-size: 0.9rem; font-weight: 700; text-decoration: none; color: #ffffff; background: #005EB8; width: fit-content; transition: all 0.2s ease; }
            .site-link-btn:hover { background: #ff0f5b; transform: translateY(-2px); }
            .dropin-box { background: #f0f7ff; border-radius: 12px; padding: 12px 16px; border: 1px solid #bfdbfe; margin-bottom: 14px; }
            .dropin-box h4 { margin: 0 0 4px 0; color: #005EB8; font-size: 0.9rem; font-weight: 800; }
            .dropin-box p { margin: 0 0 4px 0; font-size: 0.85rem; color: #334155; line-height: 1.4; }
            .dropin-box p:last-child { margin-bottom: 0; }
            .downloads-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 15px; }
            .download-card-item { background: #f8fafc; border-radius: 14px; padding: 18px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; justify-content: space-between; position: relative; }
            .member-badge { position: absolute; top: -10px; right: 12px; background: #ff0f5b; color: #ffffff; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; padding: 2px 10px; border-radius: 10px; }
            .download-card-item h4 { font-size: 1.05rem; font-weight: 800; color: #1e293b; margin: 0 0 6px 0; }
            .download-card-item p { font-size: 0.88rem; color: #64748b; line-height: 1.45; margin: 0 0 14px 0; }
            .dl-actions { display: flex; gap: 8px; flex-wrap: wrap; }
            .dl-btn { display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 8px 14px; border-radius: 16px; font-size: 0.82rem; font-weight: 700; text-decoration: none; color: white; background: #005EB8; flex: 1; text-align: center; }
            .dl-btn.green-btn { background: #1b5e20; }
            .dl-btn.pink-btn { background: #ff0f5b; }
            
  </style>

  
      
      <a href="/path-about" id="btn-support" style="position: fixed; top: 15px; right: 15px; z-index: 9999999; background: #ff0f5b; color: white; padding: 10px 20px; text-decoration: none; font-weight: bold; border-radius: 8px; font-size: 0.9rem;">About Us</a>
  
      <main class="container" id="main-content">
          <div class="header-section" style="text-align: center; margin-bottom: 40px;">
              <h1 style="font-size: 2.5rem; margin-bottom: 15px; color: #005EB8; text-align: center; display: flex; align-items: center; justify-content: center; gap: 12px;">
                  <span class="material-symbols-outlined" style="font-size: 3rem;">folder_open</span>
                  Bristol Local Directory &amp; Resources
              </h1>
              <p style="font-size: 1.15rem; color: #475569; text-align: center; max-width: 780px; margin: 0 auto; line-height: 1.6;">
                  Connect directly with local support organisations, sensory services, family charities, and community guides across Bristol.
              </p>
          </div>
  
          <!-- Progressive Disclosure Accordion Container -->
          <div class="accordion-container">
              
              <!-- ACCORDION 1: Adult & Local Community Support -->
              <div class="accordion-item active">
                  <button class="accordion-header" aria-expanded="false">
                      <span><span class="material-symbols-outlined" style="vertical-align: middle; color: #005EB8; margin-right: 8px;">domain</span> 1. Adult &amp; Local Community Support</span>
                      <span class="material-symbols-outlined accordion-icon">expand_more</span>
                  </button>
                  <div class="accordion-body">
                      <div class="directory-grid">
                          <!-- Org 1: CfD -->
                          <div class="directory-card">
                              <div>
                                  <h3>Centre for Deaf and Hard of Hearing People (CfD)</h3>
                                  <p>A community-based charity providing equipment assessments, resource rooms, BSL support, and weekly community groups in Bristol.</p>
                                  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined">call</span> <strong>Office Phone:</strong> <a href="tel:01179398653">0117 939 8653</a></li>
                                      <li><span class="material-symbols-outlined">devices</span> <strong>Equipment Line:</strong> <a href="tel:03459007830">0345 900 7830</a></li>
                                      <li><span class="material-symbols-outlined">sms</span> <strong>SMS / WhatsApp:</strong> <a href="sms:07545264840">07545 264 840</a></li>
                                      <li><span class="material-symbols-outlined">location_on</span> <strong>Address:</strong> Vassall Centre, Gill Avenue, Bristol BS16 2QQ</li>
                                  </ul>
                              </div>
                              <a href="https://cfd.org.uk" target="_blank" rel="noopener noreferrer" class="site-link-btn">
                                  <span class="material-symbols-outlined">open_in_new</span> Visit cfd.org.uk Website
                              </a>
                          </div>
  
                          <!-- Org 2: Bristol City Council Sensory Support -->
                          <div class="directory-card pink-accent">
                              <div>
                                  <h3 style="color: #ff0f5b;">Bristol City Council – Sensory Support (Adults)</h3>
                                  <p>Provides advice, rehabilitation, equipment referrals, and Care Act assessments for Deaf and hard-of-hearing adults across Bristol.</p>
                                  
                                  <div class="dropin-box">
                                      <h4>📅 Weekly Drop-in Sessions:</h4>
                                      <p><strong>Wednesdays (1:30–3:30 pm):</strong> CfD Vassall Centre (BS16 2QQ)</p>
                                      <p><strong>Fridays (1:30–3:30 pm):</strong> Bedminster Library (BS3 4AQ)</p>
                                  </div>
  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined" style="color: #ff0f5b;">mail</span> <strong>Email:</strong> <a href="mailto:sensory.impairment@bristol.gov.uk">sensory.impairment@bristol.gov.uk</a></li>
                                      <li><span class="material-symbols-outlined" style="color: #ff0f5b;">sms</span> <strong>SMS:</strong> <a href="sms:07775646671">07775 646 671</a></li>
                                      <li><span class="material-symbols-outlined" style="color: #ff0f5b;">videocam</span> <strong>Video Support:</strong> Zoom appointments available for BSL users</li>
                                  </ul>
                              </div>
                              <a href="https://www.bristol.gov.uk/social-care-health/sensory-impairment-service" target="_blank" rel="noopener noreferrer" class="site-link-btn" style="background: #ff0f5b;">
                                  <span class="material-symbols-outlined">open_in_new</span> Visit Bristol Council Portal
                              </a>
                          </div>
  
                          <!-- Org 3: HISS Bristol -->
                          <div class="directory-card green-accent">
                              <div>
                                  <h3 style="color: #1b5e20;">Hearing Impaired Support Scheme (HISS Bristol)</h3>
                                  <p>A Bristol registered charity working in partnership with UHBW NHS Audiology. Trained volunteers (many who use hearing aids themselves) provide home visits for elderly or housebound NHS hearing aid users to assist with retubing, cleaning, battery supply, and advice.</p>
                                  
                                  <div class="dropin-box" style="background: #f0fdf4; border-color: #bbf7d0;">
                                      <h4 style="color: #1B5E20;">🏠 Home Visit Maintenance &amp; Referral:</h4>
                                      <p style="color: #1B5E20;">Provides free home visits for UHBW NHS hearing aid users unable to attend clinic due to mobility, age, or disability.</p>
                                  </div>
  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined" style="color: #1b5e20;">call</span> <strong>Referral:</strong> Contact UHBW Audiology for HISS referral</li>
                                      <li><span class="material-symbols-outlined" style="color: #1b5e20;">home</span> <strong>Services:</strong> Free Home Tube Replacement, Cleaning &amp; Battery Support</li>
                                  </ul>
                              </div>
                              <a href="https://hissbristol.org.uk/" target="_blank" rel="noopener noreferrer" class="site-link-btn" style="background: #1b5e20;">
                                  <span class="material-symbols-outlined">open_in_new</span> Visit HISS Bristol Website
                              </a>
                          </div>
  
                          <!-- Org 4: UHBW NHS Audiology Postal Consumables Service -->
                          <div class="directory-card blue-accent">
                              <div>
                                  <h3 style="color: #005EB8;">UHBW NHS Audiology – Postal Batteries &amp; Tubing</h3>
                                  <p>Official online request form for patients issued NHS hearing aids by University Hospitals Bristol and Weston NHS Trust (UHBW). Request replacement batteries, mould tubing, thin tubes, domes, and cleaning wires sent directly to your home.</p>
                                  
                                  <div class="dropin-box" style="background: #f0fdf4; border-color: #bbf7d0;">
                                      <h4 style="color: #1B5E20;">📦 Postal Delivery Details:</h4>
                                      <p style="color: #1B5E20;"><strong>Free 2nd Class Delivery:</strong> Aimed within 2 weeks of request. Supplies include P13 (Orange), 312 (Brown), 675 (Blue) batteries, mould tubing, and slim tubes/domes.</p>
                                  </div>
  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined" style="color: #005EB8;">local_shipping</span> <strong>Service:</strong> Free Royal Mail delivery for registered NHS patients</li>
                                      <li><span class="material-symbols-outlined" style="color: #005EB8;">mail</span> <strong>Email:</strong> <a href="mailto:Audiology.Dept@uhbw.nhs.uk">Audiology.Dept@uhbw.nhs.uk</a></li>
                                      <li><span class="material-symbols-outlined" style="color: #005EB8;">info</span> <strong>Guidance:</strong> Please only order batteries when running low to protect NHS resources</li>
                                  </ul>
                              </div>
                              <a href="https://www.uhbw.nhs.uk/form/68E8B983DF9F63200F5B027275EE9611" target="_blank" rel="noopener noreferrer" class="site-link-btn" style="background: #005EB8;">
                                  <span class="material-symbols-outlined">open_in_new</span> Order Batteries &amp; Tubes Online
                              </a>
                          </div>
                      </div>
                  </div>
              </div>
  
              <!-- ACCORDION 2: Children, Young People & Family Support -->
              <div class="accordion-item">
                  <button class="accordion-header" aria-expanded="false">
                      <span><span class="material-symbols-outlined" style="vertical-align: middle; color: #7B1FA2; margin-right: 8px;">family_restroom</span> 2. Children, Young People &amp; Family Support</span>
                      <span class="material-symbols-outlined accordion-icon">expand_more</span>
                  </button>
                  <div class="accordion-body">
                      <div class="directory-grid">
                          <!-- Org 3: Deaf Children's Society (NDCS) Bristol -->
                          <div class="directory-card">
                              <div>
                                  <h3>Bristol &amp; South Glos Deaf Children’s Society</h3>
                                  <p>Grassroots parent-led group affiliated with NDCS, organizing family events, advice sessions, and peer connections across Bristol.</p>
                                  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined">support_agent</span> <strong>National NDCS Helpline:</strong> <a href="tel:08088008880">0808 800 8880</a></li>
                                      <li><span class="material-symbols-outlined">sms</span> <strong>SMS Support:</strong> <a href="sms:07786202955">07786 202 955</a></li>
                                      <li><span class="material-symbols-outlined">mail</span> <strong>Local Group Email:</strong> <a href="mailto:bristol@ndcsgroup.org.uk">bristol@ndcsgroup.org.uk</a></li>
                                      <li><span class="material-symbols-outlined">groups</span> <strong>Audience:</strong> Deaf/HoH children 0–25 &amp; their families</li>
                                  </ul>
                              </div>
                              <a href="https://www.ndcs.org.uk" target="_blank" rel="noopener noreferrer" class="site-link-btn">
                                  <span class="material-symbols-outlined">open_in_new</span> Visit NDCS National Website
                              </a>
                          </div>
  
                          <!-- Org 4: Sensory Support Service (Education) -->
                          <div class="directory-card" style="border-top-color: #7B1FA2;">
                              <div>
                                  <h3 style="color: #7B1FA2;">Sensory Support Service (Bristol &amp; S. Glos Schools)</h3>
                                  <p>Specialist teachers for deaf children supporting nurseries, primary/secondary schools, FE colleges, and families across the region.</p>
                                  
                                  <ul class="contact-info-list">
                                      <li><span class="material-symbols-outlined" style="color: #7B1FA2;">call</span> <strong>Elmfield Office Phone:</strong> <a href="tel:01179038441">0117 903 8441</a></li>
                                      <li><span class="material-symbols-outlined" style="color: #7B1FA2;">mail</span> <strong>Education Support Email:</strong> <a href="mailto:sensory.support@bristol.gov.uk">sensory.support@bristol.gov.uk</a></li>
                                      <li><span class="material-symbols-outlined" style="color: #7B1FA2;">location_on</span> <strong>Address:</strong> Elmfield House, Greystoke Ave, Westbury-on-Trym, Bristol BS10 6AY</li>
                                  </ul>
                              </div>
                              <a href="https://sensorysupportservice.org.uk/" target="_blank" rel="noopener noreferrer" class="site-link-btn" style="background: #7B1FA2;">
                                  <span class="material-symbols-outlined">open_in_new</span> Visit Sensory Support Website
                              </a>
                          </div>
                      </div>
                  </div>
              </div>
  
              <!-- ACCORDION 3: Downloadable Guides & Member Checklists -->
              <div class="accordion-item">
                  <button class="accordion-header" aria-expanded="false">
                      <span><span class="material-symbols-outlined" style="vertical-align: middle; color: #1b5e20; margin-right: 8px;">download</span> 3. Initiative PDF Guides &amp; Initiate Checklists</span>
                      <span class="material-symbols-outlined accordion-icon">expand_more</span>
                  </button>
                  <div class="accordion-body">
                      <p style="color: #475569; margin: 0 0 16px 0; font-size: 0.95rem;">Access our free articles, guides, and checklists:</p>
  
                      <div class="downloads-grid"><!-- Resource 2: Auracast Broadcast Audio Article -->
                          <div class="download-card-item">
                              <h4>Auracast Broadcast Audio Article</h4>
                              <p>Technical guide on Bluetooth Auracast public broadcast audio in venues and transit stations.</p>
                              <div class="dl-actions">
                                  <a href="/Contents/Document/auracast_article.pdf" target="_blank" rel="noopener noreferrer" class="dl-btn">View Online</a>
                                  <a href="/Contents/Document/auracast_article.pdf" download class="dl-btn green-btn">Download PDF</a>
                              </div>
                          </div>
  
                          <!-- Resource 3: Audiology & Hearing Loss Summary -->
                          <div class="download-card-item">
                              <h4>Audiology &amp; Hearing Loss Summary</h4>
                              <p>Clinical audiology guide covering audiogram interpretation, NHS aids, and hearing therapy.</p>
                              <div class="dl-actions">
                                  <a href="/Contents/Document/Simon - Audiology and hearing loss.pdf" target="_blank" rel="noopener noreferrer" class="dl-btn">View Online</a>
                                  <a href="/Contents/Document/Simon - Audiology and hearing loss.pdf" download class="dl-btn green-btn">Download PDF</a>
                              </div>
                          </div><!-- Resource 5: PACE Communication Pocket Card Flyer -->
                          <div class="download-card-item">
                              <div style="text-align: center; margin: 4px 0 10px 0;">
                                  <img src="/Contents/Branding Images/HLI Flyer2.jpg" alt="PACE Communication Pocket Card Flyer" style="max-width: 100%; height: 120px; object-fit: contain; border-radius: 8px;" loading="lazy">
                              </div>
                              <h4>PACE Communication Pocket Card</h4>
                              <p>Pocket card and handout detailing the PACE communication framework (Patience, Attention, Clarity, Eye Contact).</p>
                              <div class="dl-actions">
                                  <a href="/path-awareness" class="dl-btn">View PACE Guide</a>
                                  <a href="/Contents/Branding Images/HLI Flyer2.jpg" target="_blank" rel="noopener noreferrer" class="dl-btn green-btn">Open Flyer</a>
                              </div>
                          </div>
  
                          <!-- Resource: Printable PACE Bookmark -->
                          <div class="download-card-item" style="border-left: 4px solid #005EB8; background: #f8fafc;">
                              <div style="border: 2px dashed #005EB8; border-radius: 12px; padding: 14px 16px; background: #ffffff; text-align: center; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                                  <span style="background: #005EB8; color: white; font-size: 0.72rem; font-weight: 900; padding: 2px 8px; border-radius: 10px; text-transform: uppercase; letter-spacing: 0.5px;">PACE Bookmark</span>
                                  <h4 style="margin: 8px 0 6px 0; color: #0f172a; font-size: 1.05rem; font-weight: 900;">PACE Communication Reminder</h4>
                                  <div style="font-size: 0.84rem; color: #334155; line-height: 1.55; text-align: left; display: inline-block; margin: 4px auto 0 auto;">
                                      <div><strong>P</strong> &ndash; <strong>Patience:</strong> Allow time to respond</div>
                                      <div><strong>A</strong> &ndash; <strong>Attention:</strong> Face me before speaking</div>
                                      <div><strong>C</strong> &ndash; <strong>Clarity:</strong> Speak clearly, don't shout</div>
                                      <div><strong>E</strong> &ndash; <strong>Eye Contact:</strong> Good lighting &amp; sightline</div>
                                  </div>
                              </div>
                              <h4 style="color: #005EB8;">Printable PACE Bookmark</h4>
                              <p>Print and cut out this handy PACE reminder bookmark for books, work planners, or to share with family and colleagues.</p>
                              <div class="dl-actions">
                                  <button type="button" onclick="window.print()" class="dl-btn" style="background: #005EB8; color: white; width: 100%; cursor: pointer; border: none; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                      <span class="material-symbols-outlined" style="font-size: 1.1rem;">print</span> Print PACE Bookmark
                                  </button>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>
  
          </div>
  
          <!-- Navigation Footer -->
          <nav class="back-to-journey-container" aria-label="Back Navigation" style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 40px;">
              <a href="/path-yes" class="back-to-journey-btn" style="display: inline-flex; align-items: center; gap: 8px; background: #005EB8; color: white; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 700;">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Back to Journey Hub
              </a>
              <a href="/path-support" class="back-to-journey-btn" style="background: #1e293b; color: #ffffff; display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; border-radius: 10px; text-decoration: none; font-weight: 700;">
                  <span class="material-symbols-outlined">arrow_back</span>
                  Back to Support Hub
              </a>
          </nav>
              <footer class="hli-minimal-footer">
              <span>&copy; 2026 Bristol Hearing Loss Initiative &bull; Unincorporated Non-Profit</span>
          </footer>
      </main>
  
      
</BaseLayout>
