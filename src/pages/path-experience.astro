---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hearing Experience | Bristol Hearing Loss Initiative"
  description="An interactive sensory simulator demonstrating the lived experience of frequency loss, tinnitus, and background noise."
  bodyClass="premium-white-theme"
>
  <style is:global>
    html, body { 
      background: #000000 !important; 
      background-color: #000000 !important; 
      margin: 0; 
      padding: 0; 
      overflow: hidden !important; 
      width: 100vw; 
      height: 100vh; 
      height: 100dvh;
      font-family: 'Inter', sans-serif;
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      caret-color: transparent;
      outline: none;
      overscroll-behavior: none !important;
      touch-action: none !important;
      position: fixed;
      top: 0;
      left: 0;
    }
    
    .matrix-glitch-active {
      animation: matrix-glitch 0.5s linear;
    }
    @keyframes matrix-glitch {
      0% { text-shadow: 0 0 5px #0f0; transform: translate(0); }
      25% { text-shadow: -2px 0 2px #0f0, 2px 0 2px #f00; transform: translate(-2px, 2px); }
      50% { text-shadow: 2px 0 2px #0f0, -2px 0 2px #f00; transform: translate(2px, -2px); }
      100% { text-shadow: 0 0 5px #0f0; transform: translate(0); }
    }

    #state-intro, #state-prologue { 
      position: fixed; 
      top: 0; 
      left: 0; 
      width: 100vw; 
      height: 100vh; 
      height: 100dvh;
      overflow: hidden;
      overscroll-behavior: none;
      touch-action: none;
      transition: opacity 1.8s ease-in-out; 
    }
    
    #state-intro { 
      display: flex; 
      flex-direction: column; 
      justify-content: center; 
      align-items: center; 
      z-index: 300; 
      background: radial-gradient(circle at 50% 45%, rgba(15, 23, 42, 0.6) 0%, rgba(0, 0, 0, 0.95) 75%, #000000 100%); 
      opacity: 1; 
    }

    @keyframes gentleHeadlineFadeIn {
      0% {
        opacity: 0;
        transform: translateY(12px) scale(0.97);
        filter: blur(8px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    .cinematic-headline {
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: clamp(1.8rem, 5vw, 3.2rem);
      font-weight: 300;
      text-align: center;
      line-height: 1.25;
      margin: 0;
      letter-spacing: -0.02em;
      text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
      padding: 0 20px;
      animation: gentleHeadlineFadeIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      will-change: opacity, transform, filter;
    }
    .cinematic-headline .accent-glow {
      font-weight: 800;
      color: #ffffff;
      text-shadow: 0 0 25px rgba(0, 164, 239, 0.6);
    }
    
    #state-prologue { 
      z-index: 200; 
      opacity: 0; 
      background: #000000; 
      display: none; 
      overflow: hidden;
    }
    
    .stat { 
      position: absolute; 
      font-size: clamp(1.05rem, 2vw, 1.55rem); 
      font-family: 'Georgia', serif; 
      font-style: italic; 
      line-height: 1.5;
      color: #ffffff; 
      white-space: normal; 
      word-wrap: break-word;
      overflow-wrap: break-word;
      text-align: center;
      width: max-content;
      max-width: 86vw;
      margin: 0;
      padding: 0;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.75);
      opacity: 0; 
      transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1); 
      pointer-events: none;
    }
    .stat .base-text { 
      display: inline;
      font-family: 'Georgia', serif;
      font-style: italic;
      color: #ffffff;
      transition: opacity 1s ease; 
    }
    .stat .highlight { 
      display: inline;
      font-family: 'Georgia', serif;
      font-style: normal;
      font-weight: 800; 
      padding: 0 4px; 
      font-size: 1.05em;
      text-shadow: 0 0 35px currentColor;
      transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1), transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); 
    }
    
    #btn-support {
      position: fixed;
      top: 24px;
      right: 28px;
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.45);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.5px;
      text-decoration: none;
      cursor: pointer;
      z-index: 9999999;
      font-family: 'Inter', sans-serif;
      transition: color 0.2s ease, opacity 0.2s ease;
    }
    #btn-support:hover {
      color: #ffffff;
      opacity: 0.9;
    }

    #continue-btn, #begin-btn { 
      position: absolute;
      bottom: 42px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
      z-index: 250;
      cursor: pointer;
      pointer-events: auto;
      background: transparent;
      border: none;
      padding: 0;
      font-family: 'Inter', sans-serif;
      user-select: none;
      white-space: nowrap;
      transition: color 0.2s ease, opacity 0.2s ease;
    }
    #continue-btn:hover, #begin-btn:hover {
      color: #ffffff;
      opacity: 0.9;
    }

    /* STATE 3: FULLSCREEN HEARING EXPO VIDEO REEL */
    #state-expo-video {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      z-index: 400;
      background: #000000;
      display: none;
      opacity: 0;
      transition: opacity 1.2s ease-in-out;
      overflow: hidden;
      cursor: pointer;
    }

    .video-stage {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #expo-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Video Transition Fade Overlay: in from black -> out into white */
    #video-fade-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: #000000;
      opacity: 1;
      pointer-events: none;
      z-index: 100;
      transition: opacity 1.0s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease;
    }

    .click-continue-prompt {
      position: absolute;
      bottom: 42px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 50;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
      pointer-events: none;
      font-family: 'Inter', sans-serif;
      user-select: none;
      white-space: nowrap;
      transition: color 0.2s ease, opacity 0.2s ease;
    }

    .click-continue-prompt.active-end {
      cursor: pointer;
      pointer-events: auto;
      color: rgba(255, 255, 255, 0.65);
    }
    .click-continue-prompt.active-end:hover {
      color: #ffffff;
      opacity: 0.9;
    }

    /* Subtle bottom progress bar */
    .bottom-progress {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: rgba(255, 255, 255, 0.1);
      z-index: 50;
    }

    .bottom-progress-fill {
      height: 100%;
      width: 0%;
      background: rgba(255, 255, 255, 0.6);
      transition: width 0.1s linear;
    }

    /* Mobile Landscape Auto-Orientation */
    @media (max-width: 900px) and (orientation: portrait) {
      .video-stage {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100vh;
        height: 100vw;
        transform: translate(-50%, -50%) rotate(90deg);
        transform-origin: center center;
      }
    }
  </style>

  <a href="/path-support" id="btn-support" aria-label="Support Hub">[ Support Hub &rarr; ]</a>
  
  <!-- STAGE 1: INTRO PROMPT -->
  <div id="state-intro" style="cursor: pointer;">
    <h1 id="intro-text" class="cinematic-headline">
      Experience the reality<br>of <span class="accent-glow">hearing loss</span>.
    </h1>
    <div id="begin-btn">[ Click to begin ]</div>
  </div>

  <!-- STAGE 2: PROLOGUE TEXT SENSORY SIMULATOR -->
  <div id="state-prologue">
    <div id="continue-btn">[ Click to continue ]</div>
  </div>

  <!-- STAGE 3: HEARING EXPO FULLSCREEN VIDEO (REPLACING OLD STATIC END SCREEN) -->
  <div id="state-expo-video">
    <div class="video-stage">
      <video id="expo-video" playsinline webkit-playsinline x5-playsinline preload="auto" poster="/Contents/Videos/expo-reel-poster.jpg">
        <source src="/Contents/Videos/expo-reel.webm" type="video/webm">
        <source src="/Contents/Videos/expo-reel.mp4" type="video/mp4">
      </video>

      <!-- Click to continue prompt inside rotated stage -->
      <div class="click-continue-prompt">[ Click anywhere to continue ]</div>

      <!-- Bottom progress line inside rotated stage -->
      <div class="bottom-progress">
        <div id="video-progress-fill" class="bottom-progress-fill"></div>
      </div>
    </div>

    <!-- Fade Overlay for Video -->
    <div id="video-fade-overlay"></div>
  </div>

  <!-- Restaurant Ambiance Audio for Stage 2 Simulator -->
  <audio id="bg-noise" src="/Contents/Audio/freesound_community-restaurant-ambiance-23613.mp3" loop preload="none"></audio>

  <!-- Persistent Volume Control Widget for Audio Simulator -->
  <div id="volume-control-container" style="position: fixed; bottom: 20px; right: 20px; z-index: 999999; display: flex; align-items: center; gap: 10px; background: rgba(0,0,0,0.7); padding: 10px 15px; border-radius: 20px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); color: #fff;">
    <span class="material-symbols-outlined" id="volume-icon" style="cursor: pointer; font-size: 1.5rem; user-select: none;">volume_up</span>
    <input type="range" id="volume-slider" min="0" max="1" step="0.05" value="0.15" style="width: 80px; cursor: pointer; accent-color: #ff0f5b;">
  </div>

  <script is:inline>
    const rawPhrases = [
      "People making “pardon?” jokes or pretending they cannot hear, which can feel belittling rather than funny.",
      "Struggling to follow conversations around the dinner table when several family members speak at once.",
      "Feeling left out at family meals because the conversation moves on before you have understood what was said.",
      "Family members becoming frustrated when they have to repeat themselves.",
      "Being told “never mind” when you ask what someone said, leaving you feeling excluded.",
      "Pretending you heard something because asking again feels awkward.",
      "Laughing along with everyone else even though you did not hear the joke.",
      "Feeling isolated in a room full of people because you cannot follow the conversation.",
      "People assuming you are ignoring them when you simply did not hear them.",
      "Being called rude, distant or unfriendly because you missed someone speaking to you.",
      "Feeling anxious about meeting new people because you worry you will not understand them.",
      "Avoiding restaurants, pubs and cafés because background noise makes conversation exhausting.",
      "Choosing where to sit based on lighting, noise and whether you can see people’s faces.",
      "Missing important parts of conversations when someone turns their head away while speaking.",
      "Struggling when people cover their mouths, mumble or speak while eating.",
      "Feeling uncomfortable asking someone to remove their hand from their mouth.",
      "Being told “you heard that!” when you can hear some sounds but not understand every word.",
      "People not understanding that hearing loss can change depending on background noise and the speaker.",
      "Hearing a voice but not being able to make out what the person actually said.",
      "Feeling blamed for communication problems that are not entirely your fault.",
      "Family members shouting instead of speaking clearly, which can actually make understanding harder.",
      "People speaking exaggeratedly slowly because they assume hearing loss means you cannot understand them.",
      "Hearing aids amplifying background noises like clattering dishes, making conversations in social settings incredibly difficult.",
      "Struggling with the sudden, sharp clinking of cutlery or laughter in a busy restaurant.",
      "Feeling that friends avoid calling or inviting you out because they find communicating with you too difficult.",
      "Worrying that you are becoming a burden to your family because you need things repeated.",
      "Experiencing a sense of grief or loss for the ease of effortless, natural conversation.",
      "Losing the subtle nuances, tone of voice and emotional undertone of what someone is saying.",
      "Struggling to follow television programs, movies or plays even with subtitles or high volume.",
      "The sheer physical and mental fatigue of straining to listen and lip-read for hours at time.",
      "Feeling that people suspect you of 'hearing only what you want to hear'.",
      "The distinct frustration of missing a joke or story while everyone else is laughing.",
      "Experiencing communication barriers in public places like banks, shops and post offices.",
      "Struggling to understand announcements at train stations, airports or on buses.",
      "The worry and isolation of being unable to hear important safety warnings or alerts.",
      "Feeling cut off from the small, everyday social interactions that build connections with others.",
      "People assuming hearing loss is a sign of declining mental ability, rather than a physical barrier."
    ];
    
    const colors = ['#38bdf8', '#f39c12', '#38bdf8', '#f39c12', '#ff0f5b', '#00ffcc'];

    function processPhrases(phrases) {
      return phrases.map(p => {
        const regex = /(“[^”]+”)|(belittling|frustrated|excluded|awkward|isolated|exhausting|difficult|struggling|uncomfortable|blamed|distrust|anxious|stressful|vulnerable|embarrassed|tired|lonely|grieving|hearing aids|background noise|restaurants|subtitles|ignoring|misunderstood|shouting|speaking|mumbled|accents|conversation|turns their head|lip-reading|facial expressions|covering mouths|losing friendships|friends|left out|isolated)/gi;
        const parts = [];
        let lastIdx = 0;
        let match;

        while ((match = regex.exec(p)) !== null) {
          if (match.index > lastIdx) parts.push({ type: 'base', text: p.slice(lastIdx, match.index) });
          parts.push({ type: 'highlight', text: match[0] });
          lastIdx = regex.lastIndex;
        }
        if (lastIdx < p.length) parts.push({ type: 'base', text: p.slice(lastIdx) });
        return parts;
      });
    }
    
    const structuredPhrases = processPhrases(rawPhrases);

    document.addEventListener("DOMContentLoaded", () => {
      const stateIntro = document.getElementById('state-intro');
      const introText = document.getElementById('intro-text');
      const statePrologue = document.getElementById('state-prologue');
      const continueBtn = document.getElementById('continue-btn');
      const audio = document.getElementById('bg-noise');
      const volumeSlider = document.getElementById('volume-slider');
      const volumeIcon = document.getElementById('volume-icon');
      const volumeControl = document.getElementById('volume-control-container');

      // Video elements for Stage 3
      const stateExpoVideo = document.getElementById('state-expo-video');
      const expoVideo = document.getElementById('expo-video');
      const videoFadeOverlay = document.getElementById('video-fade-overlay');
      const videoProgressFill = document.getElementById('video-progress-fill');

      localStorage.setItem('hasVisitedSupport', 'true');

      // Volume Control Logic for Restaurant Audio
      if (volumeSlider && volumeIcon) {
        volumeSlider.addEventListener('input', (e) => {
          const val = e.target.value;
          audio.volume = val;
          if (val == 0) {
            volumeIcon.textContent = 'volume_off';
          } else if (val < 0.3) {
            volumeIcon.textContent = 'volume_down';
          } else {
            volumeIcon.textContent = 'volume_up';
          }
        });

        volumeIcon.addEventListener('click', () => {
          if (audio.muted) {
            audio.muted = false;
            volumeIcon.textContent = volumeSlider.value < 0.3 ? 'volume_down' : 'volume_up';
          } else {
            audio.muted = true;
            volumeIcon.textContent = 'volume_off';
          }
        });
      }

      // STAGE 1 -> STAGE 2: Click to begin sensory simulator
      let experienceStarted = false;
      stateIntro.addEventListener('click', () => {
        if (experienceStarted) return;
        experienceStarted = true;
        
        introText.classList.add('matrix-glitch-active');

        // Play restaurant ambient audio softly and fade in
        audio.volume = 0;
        audio.play().then(() => {
          let vol = 0;
          const fadeAudio = setInterval(() => {
            if (vol < 0.15) {
              vol += 0.02;
              audio.volume = vol;
              if (volumeSlider) volumeSlider.value = vol;
            } else {
              clearInterval(fadeAudio);
            }
          }, 150);
        }).catch(err => {
          console.log("Audio autoplay block bypass failed:", err);
        });

        introText.style.transform = 'scale(1.1)';
        
        setTimeout(() => {
          stateIntro.style.opacity = '0';
          statePrologue.style.display = 'block';
          statePrologue.style.opacity = '0';
          
          setTimeout(() => {
            stateIntro.style.display = 'none';
            statePrologue.style.opacity = '1';
            playPrologueLoop();
          }, 1800);
        }, 500);
      });

      // STAGE 2 -> STAGE 3: Transition from text simulator to Hearing Expo Video
      let videoTransitioningOut = false;

      function transitionToSupportHub(isManual = false) {
        if (videoTransitioningOut) return;
        videoTransitioningOut = true;

        if (videoFadeOverlay) {
          videoFadeOverlay.style.transition = "opacity 1.0s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease";
          videoFadeOverlay.style.backgroundColor = "#ffffff";
          videoFadeOverlay.style.opacity = "1";
        }

        if (isManual && expoVideo && !expoVideo.paused) {
          const fadeAudio = setInterval(() => {
            if (expoVideo.volume > 0.08) {
              expoVideo.volume -= 0.08;
            } else {
              expoVideo.volume = 0;
              clearInterval(fadeAudio);
            }
          }, 40);
        }

        setTimeout(() => {
          localStorage.setItem("hasVisitedSupportReel", "true");
          window.location.href='/path-support';
        }, 1000);
      }

      continueBtn.addEventListener('click', () => {
        // Fade out text simulator and restaurant audio
        if (statePrologue) {
          statePrologue.style.transition = 'opacity 1s cubic-bezier(0.4, 0, 0.2, 1)';
          statePrologue.style.opacity = '0';
        }
        if (volumeControl) volumeControl.style.display = 'none';

        if (audio) {
          let vol = audio.volume;
          const fadeAudioOut = setInterval(() => {
            if (vol > 0.02) {
              vol -= 0.02;
              audio.volume = vol;
            } else {
              audio.pause();
              clearInterval(fadeAudioOut);
            }
          }, 80);
        }

        // Show Hearing Expo video screen, fade in from black, and play video
        setTimeout(() => {
          if (statePrologue) statePrologue.style.display = 'none';

          if (stateExpoVideo) {
            stateExpoVideo.style.display = 'block';
            stateExpoVideo.style.opacity = '1';
          }

          if (videoFadeOverlay) {
            videoFadeOverlay.style.backgroundColor = "#000000";
            videoFadeOverlay.style.opacity = "1";
            requestAnimationFrame(() => {
              videoFadeOverlay.style.opacity = "0";
            });
          }

          if (expoVideo) {
            expoVideo.loop = false;
            const playPromise = expoVideo.play();
            if (playPromise !== undefined) {
              playPromise.then(() => {}).catch(() => {
                expoVideo.muted = true;
                expoVideo.play();
              });
            }

            function showEndClickPrompt() {
              const prompt = document.querySelector('#state-expo-video .click-continue-prompt');
              if (prompt) {
                prompt.classList.add('active-end');
                prompt.textContent = "[ Click to continue ]";
              }
            }

            expoVideo.addEventListener("timeupdate", () => {
              const cur = expoVideo.currentTime;
              const dur = expoVideo.duration || 10.0;
              const pct = Math.min(100, (cur / dur) * 100);
              if (videoProgressFill) videoProgressFill.style.width = pct + "%";

              if (dur > 0 && cur >= (dur - 0.08)) {
                expoVideo.pause();
                showEndClickPrompt();
              }
            });

            expoVideo.addEventListener("error", (e) => {
              console.warn("Video failed to play, navigating to Support Hub:", e);
              transitionToSupportHub(true);
            });

            expoVideo.addEventListener("ended", () => {
              showEndClickPrompt();
            });
          }
        }, 1000);
      });

      // Tap/click anywhere during video to fade to white & continue
      stateExpoVideo.addEventListener("click", () => {
        transitionToSupportHub(true);
      });

      document.addEventListener("keydown", (e) => {
        if (stateExpoVideo && stateExpoVideo.style.display === "block") {
          if (e.key === "Escape" || e.key === "Enter" || e.key === " ") {
            transitionToSupportHub(true);
          }
        }
      });
    });

    function playPrologueLoop(index = 0) {
      const container = document.getElementById('state-prologue');
      if (!container || container.style.display === 'none') return;

      const parts = structuredPhrases[index];
      const div = document.createElement('div');
      div.className = 'stat';
      
      const color = colors[Math.floor(Math.random() * colors.length)];
      
      div.innerHTML = parts.map(part => 
        part.type === 'highlight' 
          ? `<span class="highlight" style="color:${color}">${part.text}</span>` 
          : `<span class="base-text">${part.text}</span>`
      ).join('');
      
      container.insertBefore(div, document.getElementById('continue-btn'));
      
      setTimeout(() => {
        const statW = div.offsetWidth || 280;
        const statH = div.offsetHeight || 60;

        const screenW = window.innerWidth;
        const screenH = window.innerHeight;
        const isMobile = screenW <= 600;

        const minMarginX = isMobile ? 16 : 40;
        const minMarginTop = isMobile ? 60 : 90;
        const minMarginBottom = isMobile ? 120 : 140;

        const minCenterX = minMarginX + (statW / 2);
        const maxCenterX = screenW - minMarginX - (statW / 2);

        const minCenterY = minMarginTop + (statH / 2);
        const maxCenterY = screenH - minMarginBottom - (statH / 2);

        let targetX, targetY;

        if (index === 0 || maxCenterX <= minCenterX) {
          targetX = screenW / 2;
        } else {
          targetX = minCenterX + Math.random() * (maxCenterX - minCenterX);
        }

        if (maxCenterY <= minCenterY) {
          targetY = screenH / 2;
        } else {
          targetY = minCenterY + Math.random() * (maxCenterY - minCenterY);
        }

        div.style.left = `${targetX}px`;
        div.style.top = `${targetY}px`;
        div.style.transform = 'translate(-50%, -50%)';
        
        div.style.opacity = '1';
        setTimeout(() => {
          div.querySelectorAll('.base-text').forEach(t => t.style.opacity = '0');
        }, 3000);
      }, 50);

      setTimeout(() => playPrologueLoop((index + 1) % structuredPhrases.length), 4500);
    }
  </script>
</BaseLayout>
