---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hearing Loss Initiative - Bristol"
  description="Empowering deaf and hard-of-hearing individuals across Bristol. Access venue accessibility guides, NHS audiology paths, and community meetups."
>
  <div class="main-container">
    <header class="top-nav">
      <div class="top-left-nav">
        <button id="who-we-are-btn" class="who-we-are-dropdown-btn">
          Who We Are <span class="caret">▾</span>
        </button>
        <div id="who-we-are-dropdown-menu" class="who-we-are-dropdown-menu">
          <div class="dropdown-tag">OUR THREE PILLARS</div>
          <div class="dropdown-pillar">
            <div class="dropdown-pillar-header">
              <span class="dropdown-pillar-num">1</span>
              <span class="dropdown-pillar-title">Who We Are</span>
            </div>
            <p class="dropdown-pillar-desc">A local Bristol initiative supporting hard-of-hearing residents and their families.</p>
          </div>
          <div class="dropdown-pillar">
            <div class="dropdown-pillar-header">
              <span class="dropdown-pillar-num">2</span>
              <span class="dropdown-pillar-title">What We're Here For</span>
            </div>
            <p class="dropdown-pillar-desc">Clear, practical guidance bridging the gap between NHS care, technology, and daily life.</p>
          </div>
          <div class="dropdown-pillar">
            <div class="dropdown-pillar-header">
              <span class="dropdown-pillar-num">3</span>
              <span class="dropdown-pillar-title">What We Offer</span>
            </div>
            <p class="dropdown-pillar-desc">Accessible venue guides, NHS pathways, equipment advice, and peer support network.</p>
          </div>
        </div>
      </div>

      <img src="/Contents/Branding Images/HLI Logo White.png" alt="HLI Logo" id="hli-logo" class="hli-logo-top" />
      <a href="/path-about" id="btn-support" class="nav-btn-small top-support-btn">About Us</a>
    </header>

    <a href="https://visitbristol.co.uk/" target="_blank" rel="noopener noreferrer" aria-label="Visit Bristol website (Video courtesy of Visit Bristol)" style="cursor: pointer;">
      <div class="video-mask-container" title="Click to visit Visit Bristol website">
        <video id="bg-video" autoplay loop muted playsinline preload="metadata" poster="/Contents/Videos/bristol-bg-poster.jpg">
          <source src="/Contents/Videos/bristol-bg.webm" type="video/webm" />
          <source src="/Contents/Videos/bristol-bg.mp4" type="video/mp4" />
        </video>
      </div>
    </a>

    <div class="landing-bottom-left-controls">
      <button id="video-toggle" aria-label="Pause Background Video" title="Pause Background Video">
        <span class="icon">⏸</span>
      </button>
      <a href="https://visitbristol.co.uk/" target="_blank" rel="noopener noreferrer" class="visit-bristol-disclaimer" title="Visit Bristol official website">
        Video courtesy of Visit Bristol &#8599;
      </a>
    </div>

    <svg id="stencil-mask-svg" class="mask-overlay-svg" width="100%" height="100%" aria-hidden="true">
      <defs>
        <radialGradient id="prologue-mask-grad" cx="50%" cy="50%" r="75%">
          <stop offset="0%" stop-color="#0d213a" />
          <stop offset="40%" stop-color="#081220" />
          <stop offset="75%" stop-color="#040810" />
          <stop offset="100%" stop-color="#000000" />
        </radialGradient>
        <mask id="stencil-cutout-mask">
          <rect width="100%" height="100%" fill="white" />
          <text id="stencil-svg-text" class="stencil-svg-text" x="50%" y="50%" text-anchor="middle" dominant-baseline="central">62220</text>
        </mask>
      </defs>
      <rect width="100%" height="100%" fill="url(#prologue-mask-grad)" mask="url(#stencil-cutout-mask)" />
    </svg>

    <div id="main-content" class="mask-overlay-accessible" role="region" aria-label="Bristol Outreach Goal Countdown">
      <h1 class="stencil-layer visually-hidden" id="stencil-count" aria-live="polite" aria-atomic="true" aria-label="Estimated 62,220 Bristol adults still to reach">62220</h1>
    </div>

    <div class="content-layer" id="content-layer">
      <div id="bottom-action-panel">
        <div id="intro-block">
          <p class="official-text">
            <em>
              Estimates from the
              <a href="https://www.bristol.gov.uk/jsna" target="_blank" rel="noopener noreferrer" class="citation-link">Bristol City Council JSNA Report &#8599;</a>
              and
              <a href="https://rnid.org.uk/about-us/research-and-policy/facts-and-figures/" target="_blank" rel="noopener noreferrer" class="citation-link">National RNID Statistics &#8599;</a>
              indicate&nbsp;that<br />
              <strong class="stat-num">62<span class="small-comma">,</span>220</strong> adults in
              <strong style="font-weight: 900; color: #ffffff;">Bristol</strong> currently live with some form of
              <strong style="font-weight: 900; color: #ffffff;">hearing loss</strong>.
            </em>
          </p>

          <div class="pathways-container">
            <div class="pathway pathway-yes">
              <h3>Are you one of the 62,220?</h3>
              <button class="cta-button btn-yes" id="cta-yes" data-tooltip="Explore Initiate pathways">Yes</button>
            </div>
            <div class="pathway pathway-support">
              <h3>Friend or family member?</h3>
              <button class="cta-button btn-support" id="cta-support" data-tooltip="Explore supporter guide">Offer Support</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>