---
interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = 'Hearing Loss Initiative Bristol - Community & Support Platform',
  bodyClass = 'premium-white-theme'
} = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#005EB8" />
    <link rel="icon" type="image/png" href="/Contents/Branding Images/favicon.png" />
    <link rel="apple-touch-icon" href="/Contents/Pictures/Favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,1,0" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <script src="/script.js" defer></script>
  </body>
</html>
